<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="@APP_ID@" path="@RESOURCE_PATH@/">
    <key name="note-file" type="s">
      <default>''</default>
      <summary>Markdown file that holds the note</summary>
      <description>An absolute path, or one starting with ~/. Empty uses Notes.md in the user data folder, usually ~/.local/share/pad/Notes.md. Takes effect the next time Pad opens.</description>
    </key>
    <key name="window-width" type="i">
      <range min="200" max="10000"/>
      <default>460</default>
      <summary>Window width, remembered between launches</summary>
    </key>
    <key name="window-height" type="i">
      <range min="200" max="10000"/>
      <default>500</default>
      <summary>Window height, remembered between launches</summary>
    </key>
  </schema>
</schemalist>
