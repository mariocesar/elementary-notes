<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="@APP_ID@" path="@RESOURCE_PATH@/">
    <key name="note-file" type="s">
      <default>''</default>
      <summary>Markdown file that holds the note</summary>
      <description>An absolute path, or one starting with ~/. Empty uses Notes.md in the user data folder, usually ~/.local/share/pad/Notes.md. Takes effect the next time Pad opens.</description>
    </key>
    <key name="font-size" type="i">
      <range min="6" max="48"/>
      <default>11</default>
      <summary>Font size of the notes, in points</summary>
      <description>Ctrl+ and Ctrl− change it in steps of one point.</description>
    </key>
    <key name="window-geometry" type="a(siiii)">
      <default>[]</default>
      <summary>Window size and position of each file, as (path, width, height, x, y)</summary>
      <description>How a file's window was when it was last closed, most recent first, up to 100 files. The position is -1 where the desktop doesn't let apps know it, as on Wayland.</description>
    </key>
  </schema>
</schemalist>
