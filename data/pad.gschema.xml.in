<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="@APP_ID@" path="@RESOURCE_PATH@/">
    <key name="note-file" type="s">
      <default>''</default>
      <summary>Markdown file that holds the note</summary>
      <description>An absolute path, or one starting with ~/. Empty uses Notes.md in the user data folder, usually ~/.local/share/pad/Notes.md. Takes effect the next time Pad opens.</description>
    </key>
    <key name="window-sizes" type="a(sii)">
      <default>[]</default>
      <summary>Window size of each file, as (path, width, height)</summary>
      <description>The size a file's window had when it was last closed, most recent first, up to 100 files.</description>
    </key>
  </schema>
</schemalist>
