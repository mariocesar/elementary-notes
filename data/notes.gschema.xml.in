<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="@APP_ID@" path="@RESOURCE_PATH@/">
    <key name="window-width" type="i">
      <default>460</default>
      <summary>Window width, remembered between launches</summary>
    </key>
    <key name="window-height" type="i">
      <default>500</default>
      <summary>Window height, remembered between launches</summary>
    </key>
  </schema>
</schemalist>
